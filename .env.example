# Copy values into your shell or an untracked .env file. Never commit secrets.

# Persistent local state (default: ~/.occultbus)
OCCULTBUS_HOME=

# Runtime behavior
OBUS_AUTO_DELIBERATION=false
OBUS_PROVIDER_BASE_URL=http://127.0.0.1:38174/v1
OBUS_OLLAMA_KEEP_ALIVE=-1
MOA_ROUTER_ROOT=

# AutoAgent is the primary autonomous harness. Install it with
# `pip install -e .` from https://github.com/HKUDS/AutoAgent, then ensure `auto` is on PATH.
# AutoAgent uses its own model environment variables; choose its non-interactive agent function here.
OBUS_AUTOAGENT_COMMAND=auto
OBUS_AUTOAGENT_AGENT_FUNCTION=get_system_triage_agent
OBUS_AUTOAGENT_MODEL=
# When AutoAgent is unavailable or returns an error, use Codex as the secondary harness.
OBUS_AUTOAGENT_FALLBACK_CODEX=true

# Codex uses `codex login`; OPENAI_API_KEY is optional for API-based flows and Codex is the fallback harness.
OPENAI_API_KEY=

# Optional providers
OCCULTBUS_API_KEY=
NOUS_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=
AZURE_OPENAI_API_KEY=
