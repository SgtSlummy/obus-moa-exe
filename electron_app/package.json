{
  "name": "obus-desktop",
  "version": "1.0.1",
  "description": "Standalone OBus desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.obus.desktop",
    "productName": "OBus",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../dist/OBus.exe",
        "to": "backend/OBus.exe"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
